# Copy to apps/api/.env for local development.
# In Docker, compose.yaml's `env_file: apps/api/.env` + `environment:` block
# supply these instead — see section 24 of the implementation plan.

NODE_ENV=development
PORT=4000

# Point these at the Postgres/Redis started by `docker compose up postgres redis`
# (exposed on the host at these ports — remapped off the 5432/6379 defaults
# since those are commonly already taken by another project) when running
# the API locally with `pnpm dev`.
DATABASE_URL=postgresql://sso:sso@localhost:5434/sso
REDIS_URL=redis://localhost:6381

SSO_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
DEMO_APP_A_BASE_URL=http://localhost:3002
DEMO_APP_B_BASE_URL=http://localhost:3003

OIDC_ISSUER=http://localhost:4000
# Optional outside production — an ephemeral key is generated at boot if
# unset (see apps/api/src/oidc/jwks.ts), which is fine for local dev but
# invalidates tokens/sessions on every restart. Generate a persistent one with:
#   pnpm --filter @sso-platform/api generate-jwks
OIDC_JWKS=
# Encrypts OAuth client secrets at rest. Generate with: openssl rand -base64 32
CLIENT_SECRET_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
# Generate with: openssl rand -base64 32
COOKIE_SECRET=replace-with-a-32-plus-character-secret

ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

LOG_LEVEL=info

# Optional — seeds a super-admin user (prisma/seed.ts) when both are set.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
