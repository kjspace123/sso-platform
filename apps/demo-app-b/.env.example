# Register this app first: sign in to admin-web as an admin, go to
# Applications -> New application, type Confidential, redirect URI
#   http://localhost:3003/callback
# then copy the clientId and (one-time-shown) clientSecret here.

NEXT_PUBLIC_APP_URL=http://localhost:3003
OIDC_ISSUER=http://localhost:4000
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Encrypts this app's own session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
