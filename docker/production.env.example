# Copy to docker/production.env; never commit the populated file.
# All three hosts must share a registrable domain for SameSite cookies.
SSO_HOST=sso.example.com
ADMIN_HOST=admin.example.com
API_HOST=identity.example.com
ACME_EMAIL=operations@example.com
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# URL-encode passwords in these URLs. Match the passwords above.
DATABASE_URL=postgresql://sso:REPLACE@postgres:5432/sso
REDIS_URL=redis://:REPLACE@redis:6379
# Generate each independently with openssl rand -base64 32.
CLIENT_SECRET_ENCRYPTION_KEY=
COOKIE_SECRET=
# Paste the private JSON produced by pnpm --filter @sso-platform/api generate-jwks.
OIDC_JWKS=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LOG_LEVEL=info
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
API_RATE_LIMIT=120
OIDC_RATE_LIMIT=120
